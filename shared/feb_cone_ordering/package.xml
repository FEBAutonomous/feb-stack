<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>feb_cone_ordering</name>
  <version>0.1.0</version>
  <description>The team's cone ordering (Delaunay boundaries, a slope field integrated into a car path, rungs projected onto the boundaries) as a simulator node and service.</description>
  <maintainer email="pranavbhatttheonlyone@gmail.com">FEB Autonomous</maintainer>
  <license>MIT</license>
  <buildtool_depend>ament_cmake</buildtool_depend>
  <buildtool_depend>rosidl_default_generators</buildtool_depend>
  <depend>rclcpp</depend>
  <depend>geometry_msgs</depend>
  <exec_depend>rosidl_default_runtime</exec_depend>
  <member_of_group>rosidl_interface_packages</member_of_group>
  <export><build_type>ament_cmake</build_type></export>
</package>
