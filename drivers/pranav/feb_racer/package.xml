<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>feb_racer</name>
  <version>0.1.0</version>
  <description>FEB memory racer for walls: warm-up lap maps, then a raceline tracked by pure pursuit; the gap follower underneath</description>
  <maintainer email="pranavbhatttheonlyone@gmail.com">Formula Electric at Berkeley</maintainer>
  <license>BSD-2-Clause</license>
  <exec_depend>rclpy</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>nav_msgs</exec_depend>
  <exec_depend>ackermann_msgs</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
